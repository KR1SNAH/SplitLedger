# Copy to .env and change for anything beyond local development.
# docker-compose.yml (local) has defaults for all of these; docker-compose.prod.yml requires the
# secrets and refuses to start without them.
DB_USERNAME=splitledger
DB_PASSWORD=splitledger
# Generate with: openssl rand -base64 48
JWT_SECRET=
COOKIE_SECURE=false
ADMIN_EMAIL=admin@splitledger.dev
ADMIN_PASSWORD=admin12345

# Production only (docker-compose.prod.yml): the public domain Caddy gets an HTTPS certificate for.
# SITE_ADDRESS=splitledger.duckdns.org
